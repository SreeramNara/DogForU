# Copy this file to .env and fill in your own keys.

# Petfinder API (free): https://www.petfinder.com/developers/
PETFINDER_KEY=your_petfinder_api_key
PETFINDER_SECRET=your_petfinder_api_secret

# ipinfo.io token (optional; works without one at low traffic): https://ipinfo.io/signup
IPINFO_TOKEN=

# Set to 1 to run Flask in debug mode locally
FLASK_DEBUG=1
